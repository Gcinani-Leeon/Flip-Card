{
  "metadata": {
    "title": "Flip Card",
    "name": "flip-card",
    "version": "1.0.0",
    "category": "payment",
    "tags": "payment, credit-card, flip, 3d, dark-mode, responsive",
    "min_width": "320px",
    "recommended_width": "416px",
    "default_design_system": "inkpage"
  },
  "description": "A 3D flip credit card. The navy front shows a metallic-silver number, a gold EMV chip, a contactless glyph and duo-tone network marks; clicking or pressing Enter rotates it on the Y axis to reveal the magnetic stripe, an Allura signature panel and the CCV.",
  "features": [
    "3D Y-axis flip on a real `<button>` triggered by click and by keyboard (Enter or Space)",
    "`aria-pressed` reflects the flipped state and the `aria-label` updates to describe the next action",
    "Mid-flip lift and a settle — the card scales and rises through the turn before landing",
    "Pointer-only hover preview — the card lifts and tilts; click, Enter or Space do the flipping",
    "Embossed card number and holder text via layered ink-polarity text-shadows",
    "Gold EMV chip and a contactless glyph injected from a brand-mark registry",
    "Duo-tone network discs plus a JetBrains Mono card number, expiry and security code",
    "Reverse face with a black magnetic stripe, an Allura cursive signature and the CCV block",
    "Fully respects `prefers-reduced-motion` — the flip still works but resolves instantly"
  ],
  "fileStructure": [
    {
      "file": "index.html",
      "purpose": "Entry point — card markup, single `<script src=\"script.js\">`"
    },
    {
      "file": "style.css",
      "purpose": "@import orchestrator — loads `design-tokens.css` + `css/*.css`"
    },
    {
      "file": "script.js",
      "purpose": "Sequential module loader — loads `js/*.js` in dependency order"
    },
    {
      "file": "design-tokens.css",
      "purpose": "Auto-generated by `apply-design.ts` — raw design tokens"
    },
    {
      "file": "css/variables.css",
      "purpose": "Semantic aliases (`:root`), dark overrides (`body.dark`) and card tokens"
    },
    {
      "file": "css/base.css",
      "purpose": "Reset, body layout, background layer, focus ring"
    },
    {
      "file": "css/card.css",
      "purpose": "Stage, flip mechanics, card faces, chip, number, network marks, back panel"
    },
    {
      "file": "css/responsive.css",
      "purpose": "Mobile breakpoint and prefers-reduced-motion"
    },
    {
      "file": "js/controller.js",
      "purpose": "Flip state, ARIA labels, pattern-contrast sync and brand-mark injection"
    },
    {
      "file": "js/mount.js",
      "purpose": "Bootstraps the controller"
    },
    {
      "file": "js/app.js",
      "purpose": "Entry point — mounts the component"
    }
  ],
  "dependencies": {
    "fonts": [
      {
        "name": "Mulish",
        "weights": [400, 500, 600, 700],
        "provider": "google-fonts"
      },
      {
        "name": "Allura",
        "weights": [400],
        "provider": "google-fonts"
      },
      {
        "name": "JetBrains Mono",
        "weights": [400, 500, 600],
        "provider": "google-fonts"
      }
    ],
    "libraries": "No external JS or CSS libraries — fully standalone.",
    "internal": [
      "**Design System**: `design-tokens.css` (required, generated by `apply-design.ts`)"
    ]
  },
  "modules": {
    "cssLoadOrder": [
      "design-tokens.css",
      "css/variables.css",
      "css/base.css",
      "css/card.css",
      "css/responsive.css"
    ],
    "jsLoadOrder": ["js/controller.js", "js/mount.js", "js/app.js"],
    "jsDependencyGraph": {
      "js/app.js": [],
      "js/controller.js": [],
      "js/mount.js": []
    }
  },
  "assets": [],
  "state": {
    "variables": [
      {
        "variable": "cardEl",
        "type": "HTMLElement",
        "initial": "element",
        "purpose": "The flip button whose class and ARIA state toggle"
      },
      {
        "variable": "logoEl",
        "type": "HTMLElement",
        "initial": "element",
        "purpose": "The front-face slot the bank logo is injected into"
      },
      {
        "variable": "waveEl",
        "type": "HTMLElement",
        "initial": "element",
        "purpose": "The front-face slot the contactless glyph is injected into"
      },
      {
        "variable": "hintEl",
        "type": "HTMLElement",
        "initial": "element",
        "purpose": "The instruction line updated to match the visible face"
      },
      {
        "variable": "GLYPHS",
        "type": "object",
        "initial": "map",
        "purpose": "Registry of the logo and contactless SVG brand marks"
      }
    ],
    "globals": [
      {
        "function": "renderGlyphs()",
        "module": "js/app.js",
        "purpose": "Inject the logo and contactless brand marks into their slots"
      },
      {
        "function": "setFlipped()",
        "module": "js/app.js",
        "purpose": "Apply the flipped class, `aria-pressed`, `aria-label` and hint"
      },
      {
        "function": "toggleFlip()",
        "module": "js/app.js",
        "purpose": "Flip the card to the opposite face"
      }
    ]
  },
