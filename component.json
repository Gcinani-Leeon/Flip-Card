  "animations": [
    {
      "name": "fpc-flip",
      "duration": "0.7s",
      "easing": "cubic-bezier(0.3, 0.7, 0.2, 1)",
      "element": ".fpc-card__inner",
      "effect": "Y-axis rotation between the two faces"
    },
    {
      "name": "fpc-lift",
      "duration": "0.7s",
      "easing": "cubic-bezier(0.34, 0.65, 0.28, 1)",
      "element": ".fpc-card",
      "effect": "Mid-flip lift — the card scales and rises through the turn on dedicated scale/translate keyframes"
    },
    {
      "name": "fpc-theme",
      "duration": "0.4s",
      "easing": "ease",
      "element": "body",
      "effect": "Background and text color crossfade on theme change"
    }
  ],
  "darkMode": {
    "description": "Toggle mechanism: the host shell adds/removes the `body.dark` class to switch between light and dark themes. The card face keeps its navy identity in both themes; only the surrounding page adapts.",
    "tokens": [
      {
        "alias": "--bg",
        "lightSource": "--color-background",
        "darkSource": "--dark-bg"
      },
      {
        "alias": "--text",
        "lightSource": "--color-text-primary",
        "darkSource": "--dark-text"
      },
      {
        "alias": "--text-muted",
        "lightSource": "--color-text-secondary",
        "darkSource": "--dark-text-muted"
      },
      {
        "alias": "--border",
        "lightSource": "--color-border",
        "darkSource": "--dark-border"
      },
      {
        "alias": "--shadow",
        "lightSource": "--shadow-light",
        "darkSource": "--shadow-heavy"
      },
      {
        "alias": "--ring",
        "lightSource": "--focus-ring",
        "darkSource": "--dark-focus-ring"
      }
    ]
  },
  "responsive": {
    "breakpoint": "max-width: 480px",
    "changes": [
      {
        "change": "Body padding",
        "desktop": "`--spacing-6`",
        "mobile": "`0` (card fills narrow viewports)"
      },
      {
        "change": "Card number size",
        "desktop": "`1.6rem`",
        "mobile": "`1.3rem`"
      },
      {
        "change": "Card number gap",
        "desktop": "`1.75rem`",
        "mobile": "`1rem`"
      },
      {
        "change": "Signature panel width",
        "desktop": "`15rem`",
        "mobile": "`12rem`"
      }
    ]
  },
  "accessibility": [
    {
      "pattern": "Flip control",
      "implementation": "The whole card is a native `<button>` — click, Enter and Space all flip it"
    },
    {
      "pattern": "State exposure",
      "implementation": "`aria-pressed` tracks the flipped state"
    },
    {
      "pattern": "Action label",
      "implementation": "`aria-label` updates to describe which face the next activation reveals"
    },
    {
      "pattern": "Decorative art",
      "implementation": "Logo, chip, contactless glyph and duo-tone network marks are `aria-hidden`"
    },
    {
      "pattern": "Focus indicators",
      "implementation": "`:focus-visible` with the `--ring` outline on the flip button"
    },
    {
      "pattern": "Reduced motion",
      "implementation": "`prefers-reduced-motion: reduce` makes the flip instant while still functional"
    }
  ],
  "api": [
    {
      "method": "setFlipped(flipped)",
      "returns": "Applies the flipped state, ARIA attributes and hint text"
    },
    {
      "method": "toggleFlip()",
      "returns": "Flips the card to the opposite face"
    },
    {
      "method": "renderGlyphs()",
      "returns": "Injects the logo and contactless brand marks"
    }
  ],
  "keyboardShortcuts": [
    {
      "key": "Tab",
      "action": "Move focus to the card"
    },
    {
      "key": "Enter",
      "action": "Flip the focused card"
    },
    {
      "key": "Space",
      "action": "Flip the focused card"
    }
  ],
  "knownLimitations": [
    "The card data (number, holder, expiry, CCV) is illustrative and hardcoded in the markup",
    "Hover lift and tilt are pointer-only enhancements and do not change the `aria-pressed` state",
    "Brand marks are injected by JavaScript, so they do not render if scripting is disabled"
  ],
  "customization": [
    "**Card data**: Edit the number groups, holder, expiry and CCV in `index.html`",
    "**Palette**: Adjust the card color keys in `design-systems/flip-card/DESIGN.md`",
    "**Flip speed**: Change the `transition` duration on `.fpc-card__inner`",
    "**Design system**: Run `npx tsx apply-design.ts flip-card payment/flip-card` to re-theme"
  ]
}
